// Prisma schema — learn more: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    FOUNDER
    ADMIN
    OFFICER_ALL
    OFFICER_MINUTES
    OFFICER_GAMES
    OFFICER_POLLS
    OFFICER_FUNDRAISERS
    ADVISOR
    MEMBER
}

/// Users are mirrored from Clerk. `id` is the Clerk user ID (e.g. "user_abc123").
model User {
    id          String  @id
    email       String  @unique
    displayName String
    avatarUrl   String?
    roles       Role[]  @default([MEMBER])
    gradeYear   Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    polls         Poll[]               @relation("PollCreator")
    votes         Vote[]
    minutes       MeetingMinutes[]     @relation("MinutesAuthor")
    notifications NotifySubscription[]
    fundraisers   Fundraiser[]         @relation("FundraiserCreator")
}

/// Polls officers raise for members to vote on (future feature ideas, prize
/// rules, etc.). Exactly one vote per user per poll.
model Poll {
    id          String    @id @default(cuid())
    title       String
    description String?
    createdById String
    createdBy   User      @relation("PollCreator", fields: [createdById], references: [id])
    createdAt   DateTime  @default(now())
    closesAt    DateTime?
    isClosed    Boolean   @default(false)

    options PollOption[]
    votes   Vote[]

    @@index([isClosed, createdAt])
}

model PollOption {
    id       String @id @default(cuid())
    pollId   String
    poll     Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
    label    String
    position Int    @default(0)

    votes Vote[]

    @@index([pollId])
}

model Vote {
    id           String     @id @default(cuid())
    pollId       String
    poll         Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
    pollOptionId String
    pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
    userId       String
    user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt    DateTime   @default(now())

    @@unique([pollId, userId])
    @@index([pollOptionId])
}

/// Wednesday meeting minutes (and any other meeting notes the Secretary posts).
model MeetingMinutes {
    id          String   @id @default(cuid())
    title       String
    meetingAt   DateTime
    content     String   @db.Text
    isPublished Boolean  @default(true)
    authorId    String
    author      User     @relation("MinutesAuthor", fields: [authorId], references: [id])
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([meetingAt])
}

/// End-of-month snapshot of the trophy leaderboard. Written by a cron/manual
/// job on the 1st so the "hall of fame" page never has to recompute historical
/// standings from raw games.
model MonthlyArchive {
    id       String   @id @default(cuid())
    month    Int // 1-12
    year     Int
    /// { community: [{ userId, displayName, wins }], pro: [...] }
    snapshot Json
    closedAt DateTime @default(now())

    @@unique([year, month])
}

/// Email notify-me list (e.g. for the leaderboard coming-soon teaser). `userId`
/// is optional so non-signed-in visitors can still subscribe.
model NotifySubscription {
    id        String   @id @default(cuid())
    email     String
    topic     String
    userId    String?
    user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
    createdAt DateTime @default(now())

    @@unique([email, topic])
    @@index([topic])
}

/// Fundraising campaigns run by the club. `goalCents` / `raisedCents` are
/// stored as integers to avoid float rounding. `raisedCents` is updated
/// manually by the fundraiser officer as money comes in.
model Fundraiser {
    id          String    @id @default(cuid())
    title       String
    description String    @db.Text
    goalCents   Int?
    raisedCents Int       @default(0)
    startsAt    DateTime?
    endsAt      DateTime?
    isClosed    Boolean   @default(false)
    createdById String
    createdBy   User      @relation("FundraiserCreator", fields: [createdById], references: [id])
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([isClosed, createdAt])
}

