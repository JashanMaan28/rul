# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/rul"

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Optional: webhook signing secret from Clerk dashboard (used by /api/webhooks/clerk).
# The variable name is Clerk's convention — verifyWebhook() reads it automatically.
CLERK_WEBHOOK_SIGNING_SECRET=""

# Optional route overrides — leave blank to use defaults
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Comma-separated emails seeded as ADMIN on first sign-in (Co-Presidents)
ADMIN_EMAILS=""

# Comma-separated emails seeded as FOUNDER on first sign-in (Honorary Founder).
# FOUNDER has all ADMIN powers plus a distinct badge.
FOUNDER_EMAILS=""

# Shared secret for /api/cron/* endpoints. Vercel Cron sets
# `Authorization: Bearer <CRON_SECRET>` automatically when configured.
# Generate with: openssl rand -hex 32
CRON_SECRET=""
